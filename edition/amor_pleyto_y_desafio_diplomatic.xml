    <body>
          <pb type="folio" n="[Fol. 1r]"/>
      <head>Amor pleyto y desafio</head>
          <p>En mad. A 13 de novyenbre</p>
          <p>Tragicomedia 1621 [RÚBRICA]</p>
          <pb type="folio" n="[Fol. 1v]"/>
          <pb type="folio" n="[Fol. 2r]"/>
      <div type="castList">
        <castList>
        <head>Personas del P° Acto</head>
            <castItem><role xml:id="Don_Albaro_De_Roxas_Maldonado">Don Albaro De Roxas — Maldonado</role></castItem>
            <castItem><role xml:id="Don_Juan_De_Padilla_Lorenzo_Hurtado">Don Juan De Padilla — Lorenzo Hurtado</role></castItem>
            <castItem><role xml:id="Don_Juan_De_Aragón_Pe_De_Pernia">Don Juan De Aragón — Pe° De Pernia</role></castItem>
            <castItem><role xml:id="El_Rey_Alfonso_Juan_Bau_Ta">El Rey Alfonso. — Juan Bau Ta</role></castItem>
            <castItem><role xml:id="Doña_Beatriz_La_Sa_Angela">Doña Beatriz — La Sa Angela</role></castItem>
            <castItem><role xml:id="Doña_Ana_La_Sa_Fa_De_Sores">Doña Ana. — La Sa Fa De Sores</role></castItem>
